{"description":"Schema for the ASEAN AI Governance Tracker data files. Run `frictionless validate datapackage.json` (or let the validate-data workflow do it on every pull request) to catch bad rows before they reach the page: missing required fields, duplicate IDs, values outside the allowed lists, malformed dates and source URLs that are not URLs. What this schema does NOT check is done by build.py instead: that a response's incident_id and instrument_id point at rows that exist, that a response is not dated before its incident, and that a row's date matches its date_precision. Keep the two in step: if build.py gains a new allowed value (a theme, a response type, a status), add it here too.","name":"asean-ai-governance-tracker","resources":[{"name":"incidents","path":"data/incidents.csv","schema":{"fields":[{"constraints":{"pattern":"^[A-Z]{2}-I-\\d+$","required":true,"unique":true},"name":"id","type":"string"},{"constraints":{"enum":["BN","ID","KH","LA","MM","MY","PH","SG","TH","TL","VN"],"required":true},"name":"country","type":"string"},{"constraints":{"pattern":"^\\d{4}(-\\d{2})?(-\\d{2})?$","required":true},"name":"date","type":"string"},{"constraints":{"enum":["day","month","year"],"required":true},"name":"date_precision","type":"string"},{"constraints":{"enum":["documented","approximate","unknown"],"required":true},"name":"onset_certainty","type":"string"},{"constraints":{"required":true},"name":"title","type":"string"},{"constraints":{"pattern":"^(deepfake-fraud|sexual-deepfakes|political-deepfakes|election-integrity|online-safety|general-ai|data-protection)(;(deepfake-fraud|sexual-deepfakes|political-deepfakes|election-integrity|online-safety|general-ai|data-protection))*$","required":true},"name":"themes","type":"string"},{"name":"event_id","type":"string"},{"constraints":{"required":true},"name":"summary","type":"string"},{"constraints":{"required":true},"name":"source_title","type":"string"},{"constraints":{"required":true},"format":"uri","name":"source_url","type":"string"},{"name":"more_sources","type":"string"},{"constraints":{"enum":["high","medium","low"],"required":true},"name":"confidence","type":"string"},{"constraints":{"required":true},"name":"verified_on","type":"date"},{"name":"notes","type":"string"},{"constraints":{"pattern":"^https://oecd\\.ai/en/incidents/\\S+$"},"name":"aim_url","type":"string"}]}},{"name":"responses","path":"data/responses.csv","schema":{"fields":[{"constraints":{"pattern":"^[A-Z]{2}-R-\\d+$","required":true,"unique":true},"name":"id","type":"string"},{"constraints":{"required":true},"name":"incident_id","type":"string"},{"constraints":{"pattern":"^\\d{4}(-\\d{2})?(-\\d{2})?$","required":true},"name":"date","type":"string"},{"constraints":{"enum":["day","month","year"],"required":true},"name":"date_precision","type":"string"},{"constraints":{"required":true},"name":"actor","type":"string"},{"name":"actor_role","type":"string"},{"constraints":{"enum":["statement","advisory","enforcement","block_takedown","engagement","restriction_lifted","legislation"],"required":true},"name":"type","type":"string"},{"constraints":{"enum":["yes","no"],"required":true},"name":"binding","type":"string"},{"constraints":{"enum":["existing_law","new_law","none_stated","not_applicable"],"required":true},"name":"legal_basis","type":"string"},{"name":"instrument_id","type":"string"},{"constraints":{"required":true},"name":"summary","type":"string"},{"constraints":{"required":true},"name":"source_title","type":"string"},{"constraints":{"required":true},"format":"uri","name":"source_url","type":"string"},{"name":"more_sources","type":"string"},{"constraints":{"enum":["high","medium","low"],"required":true},"name":"confidence","type":"string"},{"constraints":{"required":true},"name":"verified_on","type":"date"},{"name":"notes","type":"string"}]}},{"name":"instruments","path":"data/instruments.csv","schema":{"fields":[{"constraints":{"pattern":"^([A-Z]{2}|ASEAN)-P-\\d+$","required":true,"unique":true},"name":